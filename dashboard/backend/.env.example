# Jellyfin
DASHBOARD_JELLYFIN_API_KEY=
DASHBOARD_JELLYFIN_URL=http://jellyfin:8096

# Polled services as name:kind:url, comma separated. Empty means Jellyfin only.
DASHBOARD_SERVICE_SPECS=
DASHBOARD_SERVICE_TTL_SECONDS=30
DASHBOARD_SERVICE_TIMEOUT=5

# Host view
DASHBOARD_PROCFS_PATH=/host/proc
DASHBOARD_HOSTNAME=nuc-server
DASHBOARD_SNAPSHOT_TTL_SECONDS=2
DASHBOARD_DISK_MOUNTS=root=/host/root,wd1tb=/host/disks/wd1tb,toshiba2tb=/host/disks/toshiba2tb
DASHBOARD_IO_DEVICES=
DASHBOARD_NET_INTERFACES=
DASHBOARD_TOP_PROCESSES=10
DASHBOARD_DOCKER_API_URL=

# SMART reading written by the host at 03:00
DASHBOARD_SMART_STATE_PATH=/host/smart/latest.json

# History
DASHBOARD_HISTORY_ENABLED=true
DASHBOARD_HISTORY_DB_PATH=/data/history.db
DASHBOARD_HISTORY_INTERVAL_SECONDS=30
DASHBOARD_HISTORY_RETENTION_DAYS=30

# Cloudflare Access token check: off, log or enforce
DASHBOARD_ACCESS_MODE=off
DASHBOARD_ACCESS_TEAM_DOMAIN=
DASHBOARD_ACCESS_AUD=

DASHBOARD_DOCS_ENABLED=false
DASHBOARD_CORS_ORIGINS=
